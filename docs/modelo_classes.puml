@startuml LMSBank
skinparam classAttributeIconSize 0

class Banco <<Singleton>> {
  - {static} _instancia : Banco
  - agencia : Agencia
  - clientes : List<Cliente>
  - contas : List<Conta>
  + {static} get_instancia() : Banco
  + iniciar() : void
  + encerrar() : void
  + cadastrar_cliente(cliente) : void
  + procurar_cliente(cpf) : Cliente
  + cadastrar_conta(conta) : void
  + procurar_conta(numero) : Conta
  + montar_dashboard() : Dashboard
}

class Agencia {
  - numero_agencia : str
  - nome : str
  - telefone : str
  - endereco : str
  - contas : List<Conta>
  + adicionar_conta(conta) : void
  + listar_contas() : List<Conta>
  + montante_total() : float
  + to_dict() : dict
  + {static} from_dict(dados) : Agencia
}

class Cliente {
  - nome : str
  - cpf : str
  - data_nascimento : str
  - email : str
  - telefone : str
  - endereco : str
  - contas : List<Conta>
  + adicionar_conta(conta) : void
  + listar_contas() : List<Conta>
  + saldo_total() : float
  + to_dict() : dict
  + {static} from_dict(dados) : Cliente
}

abstract class Conta {
  - numero : str
  - saldo : float
  - cliente : Cliente
  - agencia : Agencia
  + depositar(valor) : void
  + sacar(valor) : void
  + transferir(destino, valor) : void
  + consultar_saldo() : float
  + {abstract} saldo_disponivel() : float
  + {abstract} tipo() : str
  + to_dict() : dict
}

class ContaCorrente {
  - limite : float = 500.0
  + saldo_disponivel() : float
  + tipo() : str
  + to_dict() : dict
  + {static} from_dict(dados, cliente, agencia) : ContaCorrente
}

class ContaPoupanca {
  - taxa_rendimento : float = 0.005
  - ultimo_rendimento : date
  + saldo_disponivel() : float
  + aplicar_rendimento(hoje) : float
  + tipo() : str
  + to_dict() : dict
  + {static} from_dict(dados, cliente, agencia) : ContaPoupanca
}

class ContaFactory <<Factory>> {
  + {static} criar(tipo, numero, cliente, agencia, saldo) : Conta
  + {static} from_dict(dados, cliente, agencia) : Conta
}

class Dashboard {
  - num_clientes : int
  - num_contas : int
  - saldo_total : float
  - saldo_medio : float
  - maior_saldo : float
  - maior_saldo_conta : str
  - menor_saldo : float
  - menor_saldo_conta : str
}

class BancoError <<Exception>>
class ValorInvalidoError <<Exception>>
class SaldoInsuficienteError <<Exception>>
class OperacaoInvalidaError <<Exception>>
class TipoContaInvalidoError <<Exception>>

Banco "1" o-- "1" Agencia
Banco "1" o-- "0..*" Cliente
Banco "1" o-- "0..*" Conta
Banco ..> Dashboard : gera
Banco ..> ContaFactory : usa
ContaFactory ..> Conta : cria
Agencia "1" --> "0..*" Conta : agrupa
Cliente "1" <-- "0..*" Conta : titular de
Conta "0..*" --> "1" Agencia
Conta <|-- ContaCorrente
Conta <|-- ContaPoupanca
BancoError <|-- ValorInvalidoError
BancoError <|-- SaldoInsuficienteError
BancoError <|-- OperacaoInvalidaError
BancoError <|-- TipoContaInvalidoError
Conta ..> SaldoInsuficienteError : lança
Conta ..> ValorInvalidoError : lança
note right of Conta : Template Method:\nsacar() usa saldo_disponivel()
@enduml
